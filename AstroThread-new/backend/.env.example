# Database
DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=astrothread_db
# DB_USER=postgres

# Sessions (sign in). Use a long random value; set SESSION_COOKIE_SECURE=true on the real (https) website.
SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Email with the one-time codes (the project's Gmail account and its app password)
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Local testing only: print codes in the terminal instead of emailing them
# EMAIL_MODE=console

# Admin accounts need this code at sign up
ADMIN_INVITATION_CODE=

# Research papers
OPENALEX_API_KEY=

# AI (Groq)
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile
