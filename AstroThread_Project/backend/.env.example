# Copy to backend/.env and fill in your local PostgreSQL password.
DB_PASSWORD=
# Signs the login session cookie; sign-in is disabled until it is set.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Optional (defaults shown)
# SESSION_COOKIE_SECURE=false   # set to true when served over HTTPS
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=astrothread_db
# DB_USER=postgres
# AI Research Assistant (POST /api/ai/explain). Without both it answers 503.
# OPENAI_API_KEY=            # from platform.openai.com; never commit a real key
# OPENAI_MODEL=              # an OpenAI model id, e.g. from platform.openai.com/docs/models
# AI_DAILY_LIMIT=20          # questions per user per day
