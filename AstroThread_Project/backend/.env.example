# Copy to backend/.env and fill in your local PostgreSQL password.
DB_PASSWORD=
# Signs the session cookie; sign-in is disabled until it is set.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Sign-in codes are emailed with Brevo (free plan: https://www.brevo.com).
# BREVO_API_KEY: Brevo > SMTP & API > API Keys. EMAIL_FROM: a sender address
# verified in Brevo > Senders (your Gmail works).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=AstroThread
# Development only: print codes in the Flask terminal instead of emailing them.
OTP_PRINT_TO_TERMINAL=false
# Optional (defaults shown)
# SESSION_COOKIE_SECURE=false   # set to true when served over HTTPS
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=astrothread_db
# DB_USER=postgres
