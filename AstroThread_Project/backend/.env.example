# Copy to backend/.env and fill in your local PostgreSQL password.
DB_PASSWORD=
# Optional (defaults shown)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=astrothread_db
# DB_USER=postgres

# Secret used to sign login tokens (required). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Optional: how long a login lasts, in hours (default 24)
# JWT_EXPIRES_HOURS=24
